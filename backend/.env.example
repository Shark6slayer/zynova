ENVIRONMENT=development
APP_NAME=SUPER_AI_BACKEND
APP_VERSION=1.0.0
DEBUG=True

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=super_ai_db

JWT_SECRET_KEY=your_secure_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Provider (mongodb remains default until Phase 5 cutover)
DB_PROVIDER=mongodb

# GoDaddy Professional Email (Titan) SMTP Configuration
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USERNAME=no-reply@intellidev.in
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=no-reply@intellidev.in
SMTP_FROM_NAME=SUPER_AI

# Zoho Catalyst CloudScale NoSQL (Phase 3+)
CATALYST_ENABLED=false
CATALYST_PROJECT_ID=
CATALYST_PROJECT_KEY=
CATALYST_ENVIRONMENT=Development
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=
CATALYST_ACCOUNTS_URL=https://accounts.zoho.com
CATALYST_BASE_URL=https://api.catalyst.zoho.com
CATALYST_REGION=us
CATALYST_ORG_ID=
CATALYST_REQUEST_TIMEOUT=10.0
CATALYST_MAX_CONCURRENCY=16

# Meta / Instagram Graph API Integration (Instagram API with Facebook Login)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v21.0
INSTAGRAM_REDIRECT_URI=https://api.zenova.intellidev.in/api/v1/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
WEB_APP_URL=https://www.intellidev.in
MOBILE_DEEP_LINK_SCHEME=zenova
